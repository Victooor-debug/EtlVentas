{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/etl-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Schedule": {
    "IntervalMinutes": 0
  },
  "Staging": {
    "Folder": "staging",
    "Indented": true
  },
  "Sources": {
    "Csv": {
      "Enabled": true,
      "FilePath": "Data/ventas.csv"
    },
    "Database": {
      "Enabled": true,
      "ConnectionString": "",
      "QueryFile": "Queries/ventas_db_externa.sql",
      "Desde": null,
      "CommandTimeoutSeconds": 60
    },
    "Api": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5100/",
      "Endpoint": "ventas",
      "PageSize": 2,
      "Token": ""
    }
  },
  "Analytics": {
    "ConnectionString": ""
  }
}
