        <mxCell id="n1" value="Inicio&#xa;(Worker Service)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="140" height="50" as="geometry"/></mxCell>
